<div class="mugopage-default-template-section">

    <div class="mugopage-default-template-title">Default Zone Template</div>

    {% if zone is defined and zone %}

        <div class="mugopage-default-template-subtitle">Properties</div>

        <div class="mugopage-default-template-group">
            <label>name</label>
            <div>{% if zone.name is defined and zone.name %}{{ zone.name }}{% endif %}</div>
        </div>

        <div class="mugopage-default-template-group">
            <label>identifier</label>
            <div>{% if zone.identifier is defined and zone.identifier %}{{ zone.identifier }}{% endif %}</div>
        </div>

        <div class="mugopage-default-template-group">
            <label>type</label>
            <div>{% if zone.type is defined and zone.type %}{{ zone.type }}{% endif %}</div>
        </div>

        {% set configArray = parse_stdclass_to_array(zone.config) %}

        <div class="mugopage-default-template-subtitle">Config</div>
        {% for zoneKey, zoneValue in configArray %}

            {% if zoneValue is not iterable %}
                <div class="mugopage-default-template-group">
                    <label>{{ zoneKey }}</label>
                    <div>{{ zoneValue }}</div>
                </div>
            {% else %}
                <div class="mugopage-default-template-group">
                    <label>{{ zoneKey }}</label>
                    <div><< iterable >></div>
                </div>
            {% endif %}

        {% endfor %}

        <div class="mugopage-default-template-subtitle">Blocks</div>

        {% if parameters is not defined %}
            {% set parameters = [] %}
        {% endif %}

        {% if blocks is defined and blocks %}
            {% for block in blocks %}
                {{ render_mugopage_block(block, parameters, true) }}
            {% endfor %}
        {% endif %}

    {% endif %}

</div>

<style>

    .mugopage-default-template-section {
        border-radius: 0.625rem;
        border: 0.0625rem solid #f3f3f6;
        padding: 2rem;
        margin: 2rem;
        background: #ffffff;
    }

    .mugopage-default-template-title {
        font-size: 1.2rem;
        font-weight: 700;
        border-bottom: 0.0625rem solid #f3f3f6;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
        color: #000000;
    }

    .mugopage-default-template-subtitle {
        font-size: 1rem;
        font-weight: 700;
        color: #000000;
        margin-top: 2rem;
    }

    .mugopage-default-template-group {
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        margin: 1rem 0;
    }

    .mugopage-default-template-group:hover {
        background: #f2f2f2;
    }

    .mugopage-default-template-group label {
        font-size: 0.75rem;
        flex: 1 1 100%;
        max-width: 150px;
        margin-right: 1rem;
        color: #333333;
    }

    .mugopage-default-template-group div {
        font-size: 0.875rem;
        flex: 1 1 auto;
        color: #000000;
    }

</style>